# Chenyiyun2087 Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# Database (MySQL via SQLAlchemy+PyMySQL)
# Option A: Explicit URL
# CHENYIYUN_DB_URL=mysql+pymysql://user:password@localhost:3306/chenyiyun?charset=utf8mb4

# Option B: Individual components
CHENYIYUN_DB_USER=chenyiyun_app
CHENYIYUN_DB_PASSWORD=<your_secure_password>
CHENYIYUN_DB_HOST=localhost
CHENYIYUN_DB_PORT=3306
CHENYIYUN_DB_NAME=chenyiyun
# CHENYIYUN_DB_CHARSET=utf8mb4
# CHENYIYUN_DB_UNIX_SOCKET=

# Feishu (Lark) Notification Webhook
# FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxxxx

# Scheduler
# SCHEDULER_CATCH_UP_GRACE_SECONDS=90
# DISABLE_APP_SCHEDULER_LOOP=1
